[run]
branch = True
source =
    control-plane/amazon_ads_control
    hermes-plugin/amazon_ads_control
    integrations
    scripts
omit =
    tests/*
    # These standalone contract CLIs execute in the dedicated
    # amazon-official-contract CI job against live downloaded/fixture inputs.
    # Keeping them in the unit-test denominator would report them as 0% even
    # though their release gate runs independently on every PR.
    scripts/check_amazon_mcp_contract.py
    scripts/check_project_capability_policy.py

[report]
show_missing = True
skip_covered = False
precision = 1
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
