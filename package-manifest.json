{
  "package": "hermes-amazon-ads-automation",
  "version": "1.0.0",
  "purpose": "Observable Hermes-native Amazon Ads autopilot with hard main/worker separation",
  "runtime": {
    "control_plane": "Python 3.11+ standard library",
    "database": "SQLite WAL",
    "hermes_extension": "directory plugin + namespaced skill",
    "web": "responsive read-only audit dashboard",
    "target_host": "2C2G Linux VPS"
  },
  "capabilities": [
    "Hermes pre/post tool policy hooks",
    "real subagent-to-task binding",
    "planned write matching and idempotency",
    "bid/budget/action guardrails",
    "autopilot, observe, and paused modes",
    "redacted daily task/action/event history",
    "systemd and HTTPS reverse-proxy deployment examples"
  ],
  "tests": {
    "unit_and_integration": 26,
    "process_e2e": true,
    "install_smoke": true,
    "secret_scan": true
  },
  "excluded": [
    "Amazon credentials and OAuth tokens",
    "Hermes auth/session databases",
    "raw customer/order/report payloads",
    "browser cookies and Seller Central credentials"
  ]
}
