ADS_CONTROL_HOST=127.0.0.1
ADS_CONTROL_PORT=8790
ADS_CONTROL_DB=/var/lib/hermes-amazon-ads-control/state.db
ADS_CONTROL_PUBLIC_ORIGIN=https://YOUR_DOMAIN
ADS_CONTROL_PASSWORD_HASH=pbkdf2_sha256$REPLACE
ADS_CONTROL_AGENT_TOKEN=REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS
ADS_CONTROL_SESSION_TTL=43200
ADS_CONTROL_RETENTION_DAYS=180
ADS_CONTROL_URL=http://127.0.0.1:8790
