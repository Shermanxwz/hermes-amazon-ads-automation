ADS_CONTROL_HOST=127.0.0.1
ADS_CONTROL_PORT=8790
ADS_CONTROL_DB=/var/lib/hermes-amazon-ads-control/state.db
ADS_CONTROL_PUBLIC_ORIGIN=https://YOUR_DOMAIN
ADS_CONTROL_PASSWORD_HASH=pbkdf2_sha256$REPLACE

# Machine credential used by Hermes tools/hooks. Give this to normal Hermes.
ADS_CONTROL_AGENT_TOKEN=REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS

# Web approval does not require an operator token. Leave this absent/empty in
# the normal deployment so a Hermes process with Terminal/File tools cannot
# recover a human-approval credential from the host process environment.
ADS_CONTROL_OPERATOR_TOKEN=
ADS_CONTROL_ENABLE_COMMAND_APPROVAL=false

# Hermes Studio and the scheduled Amazon Ads trigger must select the same
# Hermes home/profile. Keep these paths server-side; never expose agent tokens
# or Hermes credential files to browser JavaScript.
HERMES_HOME=/var/lib/hermes-studio/.hermes
HERMES_PROFILE=default
HERMES_BIN=/opt/hermes-agent/venv/bin/hermes
ADS_ORCHESTRATOR_MAX_TURNS=90
ADS_ORCHESTRATOR_TIMEOUT_SECONDS=1500

# Hermes plugin regional contract. Put the same variables in the Hermes
# Studio/Hermes runtime environment (not only the control service environment).
# Canonical mcp-amazon-ads is treated as this one region. Use na, eu or fe.
ADS_MCP_DEFAULT_REGION=na
# Optional comma-separated allowlist when multiple explicitly named regional
# MCP servers/toolsets are configured, e.g. mcp-amazon-ads-na,mcp-amazon-ads-fe.
ADS_MCP_TOOLSETS=mcp-amazon-ads

# Marketing Stream records do not always carry a Profile id. The relay must be
# explicitly bound to the same US Sponsored Products Profile as the controller;
# never guess this value from advertiser/account ids. Set the real value only
# in the protected production environment, never in Git or public logs.
ADS_STREAM_PROFILE_ID=REPLACE_WITH_BOUND_PROFILE_ID
ADS_STREAM_RELAY_TIMEOUT=15
ADS_STREAM_RELAY_ATTEMPTS=3

ADS_CONTROL_SESSION_TTL=43200
ADS_CONTROL_RETENTION_DAYS=180
ADS_CONTROL_MAINTENANCE_INTERVAL=21600
ADS_CONTROL_PAYLOAD_RETENTION_DAYS=30
ADS_CONTROL_METRIC_RETENTION_DAYS=60
ADS_CONTROL_SNAPSHOT_RETENTION_DAYS=45
ADS_CONTROL_STORAGE_SOFT_LIMIT_MB=512
ADS_CONTROL_STORAGE_HARD_LIMIT_MB=1024
ADS_CONTROL_MIN_FREE_DISK_MB=1024
ADS_CONTROL_VACUUM_MIN_RECLAIM_MB=64
ADS_CONTROL_OUTBOX_MAX_EVENTS=1000
ADS_CONTROL_OUTBOX_MAX_BYTES=8388608
ADS_CONTROL_OUTBOX_CORRUPT_KEEP=3
ADS_CONTROL_OUTBOX_CORRUPT_RETENTION_DAYS=30
ADS_CONTROL_URL=http://127.0.0.1:8790
